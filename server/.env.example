# Copy to .env on the VM (root-owned, chmod 600) and load it from the systemd unit.
ADDR=127.0.0.1:8080
DATA_DIR=/var/lib/gaali
PUBLIC_URL=https://api.example.com
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=
# OAuth Web client ID from the gaali-finder Google Cloud project
GOOGLE_WEB_CLIENT_ID=
# Mail provider. Resend is preferred (it leaves links untouched, which helps inbox placement);
# Brevo is the fallback. With neither key set, mails are printed to the log instead of sent.
RESEND_API_KEY=
BREVO_API_KEY=
# Comma-separated e-mails allowed into https://<your-domain>/admin (the live monitoring console).
# They must be verified accounts with a password. Empty = console disabled.
ADMIN_EMAILS=
# Optional: where replies go when MAIL_FROM is a no-reply style address.
MAIL_REPLY_TO=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Gaali Finder
